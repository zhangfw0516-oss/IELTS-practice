rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This file is a deployment template, not evidence that production uses these rules.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /sync/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
